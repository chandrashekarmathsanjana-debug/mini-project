import sqlite3

def register_user(username, email, password):
    # 1. Connect and make sure the table exists right here so it never errors out
    connection = sqlite3.connect('trip_planner.db')
    cursor = connection.cursor()

    cursor.execute('''
        CREATE TABLE IF NOT EXISTS users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            username TEXT NOT NULL,
            email TEXT UNIQUE NOT NULL,
            password TEXT NOT NULL
        );
    ''')
    connection.commit()

    # 2. Try inserting the new user
    try:
        cursor.execute('''
            INSERT INTO users (username, email, password)
            VALUES (?, ?, ?)
        ''', (username, email, password))

        connection.commit()
        print(f"Success! User '{username}' registered successfully.")

    except sqlite3.IntegrityError:
        # This triggers if you run it twice with the exact same email
        print("Notice: That email is already registered!")

    finally:
        # 3. Always close the connection
        connection.close()

# --- TEST IT OUT ---
register_user("alex_dev", "alex@example.com", "secret123")