import micropip
await micropip.install("flask")
import sqlite3
from flask import Flask, jsonify, request

app = Flask(__name__)
DB_PATH = "/tmp/trip_planner_clean.db"


def get_db():
  conn = sqlite3.connect(DB_PATH)
  conn.row_factory = sqlite3.Row
  return conn


# 1. SETUP EXPENSE & SPLIT TABLES
def init_expense_tables():
  conn = get_db()
  c = conn.cursor()
  c.execute("""CREATE TABLE IF NOT EXISTS expenses (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    trip_id INTEGER,
                    paid_by INTEGER,
                    amount REAL,
                    description TEXT
                )""")
  c.execute("""CREATE TABLE IF NOT EXISTS expense_splits (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    expense_id INTEGER,
                    user_id INTEGER,
                    owed_amount REAL,
                    is_settled INTEGER DEFAULT 0
                )""")
  conn.commit()
  conn.close()


# 2. ADD EXPENSE & SPLIT EQUALLY AMONG MEMBERS
def add_expense(trip_id, paid_by, amount, description, split_among_user_ids):
  conn = get_db()
  c = conn.cursor()

  c.execute(
      "INSERT INTO expenses (trip_id, paid_by, amount, description) VALUES (?,"
      " ?, ?, ?)",
      (trip_id, paid_by, amount, description),
  )
  expense_id = c.lastrowid

  split_amount = round(amount / len(split_among_user_ids), 2)

  for uid in split_among_user_ids:
    # The person who paid doesn't owe themselves, so mark their own share settled
    settled_status = 1 if uid == paid_by else 0
    c.execute(
        "INSERT INTO expense_splits (expense_id, user_id, owed_amount,"
        " is_settled) VALUES (?, ?, ?, ?)",
        (expense_id, uid, split_amount, settled_status),
    )

  conn.commit()
  conn.close()
  return expense_id


# 3. CALCULATE BALANCES & WHO OWES WHOM
def calculate_balances(trip_id):
  conn = get_db()
  c = conn.cursor()

  # Fetch all unsettled splits for this trip
  c.execute(
      """
        SELECT e.paid_by, s.user_id AS debtor, s.owed_amount
        FROM expense_splits s
        JOIN expenses e ON s.expense_id = e.id
        WHERE e.trip_id = ? AND s.is_settled = 0
    """,
      (trip_id,),
  )

  rows = c.fetchall()
  conn.close()

  net_balances = {}
  transactions = []

  for r in rows:
    creditor = r["paid_by"]
    debtor = r["debtor"]
    amt = r["owed_amount"]

    net_balances[creditor] = round(net_balances.get(creditor, 0) + amt, 2)
    net_balances[debtor] = round(net_balances.get(debtor, 0) - amt, 2)
    transactions.append({
        "from_user": debtor,
        "to_user": creditor,
        "amount": amt,
    })

  return {"net_balances": net_balances, "settlement_plan": transactions}


# 4. SETTLEMENT FUNCTIONALITY
def settle_debt(trip_id, debtor_id, creditor_id):
  conn = get_db()
  c = conn.cursor()

  c.execute(
      """
        UPDATE expense_splits
        SET is_settled = 1
        WHERE user_id = ? AND is_settled = 0 AND expense_id IN (
            SELECT id FROM expenses WHERE trip_id = ? AND paid_by = ?
        )
    """,
      (debtor_id, trip_id, creditor_id),
  )

  updated_rows = c.rowcount
  conn.commit()
  conn.close()
  return updated_rows > 0


# 5. API ENDPOINTS
@app.route("/expenses", methods=["POST"])
def api_add_expense():
  data = request.json
  exp_id = add_expense(
      data["trip_id"],
      data["paid_by"],
      data["amount"],
      data["description"],
      data["split_among"],  # e.g., [1, 2, 3]
  )
  return jsonify({"status": "success", "expense_id": exp_id}), 201


@app.route("/balances/<int:trip_id>", methods=["GET"])
def api_get_balances(trip_id):
  result = calculate_balances(trip_id)
  return jsonify(result), 200


@app.route("/settle", methods=["POST"])
def api_settle():
  data = request.json
  settled = settle_debt(data["trip_id"], data["from_user"], data["to_user"])
  return jsonify({"status": "settled" if settled else "no_pending_debt"}), 200


