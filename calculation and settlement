# ==========================================
# SPLITTRIP BACKEND: USERS, TRIPS & EXPENSES
# ==========================================

import sqlite3
from flask import Flask, jsonify, request

app = Flask(__name__)
DB_PATH = "trip_v2.db"


def get_db():
  conn = sqlite3.connect(DB_PATH)
  conn.row_factory = sqlite3.Row
  return conn


def init_db():
  conn = get_db()
  c = conn.cursor()

  # 1. Users table
  c.execute("""CREATE TABLE IF NOT EXISTS users (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL,
                email TEXT UNIQUE NOT NULL
            )""")

  # 2. Trips table
  c.execute("""CREATE TABLE IF NOT EXISTS trips (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                title TEXT NOT NULL,
                destination TEXT,
                created_by INTEGER
            )""")

  # 3. Trip Members table
  c.execute("""CREATE TABLE IF NOT EXISTS trip_members (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                trip_id INTEGER,
                user_id INTEGER
            )""")

  # 4. Itinerary table (placeholder for structure)
  c.execute("""CREATE TABLE IF NOT EXISTS itinerary (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                trip_id INTEGER,
                day_number INTEGER,
                activity TEXT,
                time TEXT
            )""")

  # 5. Expenses table
  c.execute("""CREATE TABLE IF NOT EXISTS expenses (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                trip_id INTEGER,
                paid_by INTEGER,
                amount REAL,
                description TEXT
            )""")

  # 6. Expense Splits table
  c.execute("""CREATE TABLE IF NOT EXISTS expense_splits (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                expense_id INTEGER,
                user_id INTEGER,
                owed_amount REAL,
                is_settled INTEGER DEFAULT 0
            )""")

  conn.commit()
  conn.close()


# Initialize database tables on startup
init_db()


# ==========================================
# PART 2: USER & TRIP MANAGEMENT ENDPOINTS
# ==========================================

@app.route("/users", methods=["POST"])
def create_user():
  data = request.json
  conn = get_db()
  c = conn.cursor()
  try:
    c.execute(
        "INSERT INTO users (name, email) VALUES (?, ?)",
        (data["name"], data["email"]),
    )
    conn.commit()
    return jsonify({"status": "success", "user_id": c.lastrowid}), 201
  except sqlite3.IntegrityError:
    return jsonify({"error": "Email already exists"}), 400
  finally:
    conn.close()


@app.route("/users", methods=["GET"])
def get_users():
  conn = get_db()
  c = conn.cursor()
  c.execute("SELECT * FROM users")
  users = [dict(row) for row in c.fetchall()]
  conn.close()
  return jsonify(users), 200


@app.route("/trips", methods=["POST"])
def create_trip():
  data = request.json
  conn = get_db()
  c = conn.cursor()
  c.execute(
      "INSERT INTO trips (title, destination, created_by) VALUES (?, ?, ?)",
      (data["title"], data["destination"], data["created_by"]),
  )
  trip_id = c.lastrowid
  c.execute(
      "INSERT INTO trip_members (trip_id, user_id) VALUES (?, ?)",
      (trip_id, data["created_by"]),
  )
  conn.commit()
  conn.close()
  return jsonify({"status": "success", "trip_id": trip_id}), 201


@app.route("/trips/<int:trip_id>/members", methods=["POST"])
def add_trip_member(trip_id):
  data = request.json
  conn = get_db()
  c = conn.cursor()
  c.execute(
      "INSERT INTO trip_members (trip_id, user_id) VALUES (?, ?)",
      (trip_id, data["user_id"]),
  )
  conn.commit()
  conn.close()
  return jsonify({"status": "success", "message": "Member added to trip"}), 201


# ==========================================
# PART 3: EXPENSE API & SPLITTING LOGIC
# ==========================================

@app.route("/trips/<int:trip_id>/expenses", methods=["POST"])
def add_expense(trip_id):
  data = request.json
  paid_by = data["paid_by"]
  amount = data["amount"]
  description = data.get("description", "Trip Expense")

  conn = get_db()
  c = conn.cursor()

  c.execute(
      "INSERT INTO expenses (trip_id, paid_by, amount, description) VALUES"
      " (?, ?, ?, ?)",
      (trip_id, paid_by, amount, description),
  )
  expense_id = c.lastrowid

  # Fetch all members to split the expense equally
  c.execute("SELECT user_id FROM trip_members WHERE trip_id = ?", (trip_id,))
  members = [row["user_id"] for row in c.fetchall()]

  if not members:
    conn.close()
    return jsonify({"error": "No members found in this trip to split with."}), 400

  share = amount / len(members)
  for user_id in members:
    c.execute(
        "INSERT INTO expense_splits (expense_id, user_id, owed_amount,"
        " is_settled) VALUES (?, ?, ?, 0)",
        (expense_id, user_id, share),
    )

  conn.commit()
  conn.close()
  return (
      jsonify({
          "status": "success",
          "expense_id": expense_id,
          "message": "Expense added and split calculated successfully!",
      }),
      201,
  )


@app.route("/trips/<int:trip_id>/expenses", methods=["GET"])
def get_trip_expenses(trip_id):
  conn = get_db()
  c = conn.cursor()
  c.execute("SELECT * FROM expenses WHERE trip_id = ?", (trip_id,))
  expenses = [dict(row) for row in c.fetchall()]
  conn.close()
  return jsonify(expenses), 200


if __name__ == "__main__":
  print("SplitTrip Backend ready to run on PC!")
